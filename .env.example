# ── LLM Provider ─────────────────────────────────────────────────────────────
# Groq (required for LangGraph workflow + query analysis + grading + generation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Embeddings (sentence-transformers, runs locally — FREE) ──────────────────
# No API key needed. Model (~90MB) is downloaded automatically on first run.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Vector Store (ChromaDB) ───────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=techdocs

# ── Web Search (Optional) ─────────────────────────────────────────────────────
# If TAVILY_API_KEY is set, Tavily is used. Otherwise, DuckDuckGo is used as a free fallback.
# Get free Tavily key: https://tavily.com
TAVILY_API_KEY=

# ── RAG Pipeline ─────────────────────────────────────────────────────────────
TOP_K=5
MAX_RETRIES=3

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_STRATEGY=hybrid     # structural | recursive | hybrid
MAX_CHUNK_CHARS=1500
OVERLAP_CHARS=150
MIN_CHUNK_CHARS=200

# ── Upload / Ingestion ────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
LOG_LEVEL=INFO
